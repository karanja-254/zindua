APP_NAME=WitnessVault
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_BUCKET_ENDPOINT=false
AWS_OBJECT_LOCK_MODE=
AWS_OBJECT_LOCK_RETAIN_UNTIL=

VITE_APP_NAME="${APP_NAME}"

# --- WitnessVault: Evidence Storage (Cloudflare R2 / AWS S3) ---
# Local development: EVIDENCE_DISK=local
# Production: r2 or s3 with credentials below.
EVIDENCE_DISK=local
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_URL=
CLOUDFLARE_R2_DEFAULT_REGION=auto
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=true
CLOUDFLARE_R2_BUCKET_ENDPOINT=false
CLOUDFLARE_R2_OBJECT_LOCK_MODE=
CLOUDFLARE_R2_OBJECT_LOCK_RETAIN_UNTIL=

SANCTUM_EXPIRATION=720

# --- WitnessVault: Telegram Broadcaster ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHANNELS=
TELEGRAM_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=

# --- WitnessVault: SMS Gateway ---
SMS_DRIVER=africastalking
SMS_EMERGENCY_RECIPIENTS=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- WitnessVault: ElevenLabs Voice Briefing ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
FFMPEG_PATH=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
